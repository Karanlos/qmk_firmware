{
    "keyboard_name": "Scylla RP2040",
    "usb": {
        "device_version": "2.0.0"
    },
    "features": {
        "bootmagic": true,
        "mousekey": false,
        "extrakey": true,
        "rgb_matrix": false
    },
    "rgb_matrix": {
        "driver": "ws2812"
    },
    "matrix_pins": {
        "cols": ["GP16", "GP17", "GP18", "GP19", "GP20", "GP21"],
        "rows": ["GP11", "GP12", "GP13", "GP14", "GP15"]
    },
    "diode_direction": "COL2ROW",
    "split": {
        "enabled": true,
        "serial": {
            "pin": "GP6"
        }
    },
    "ws2812": {
        "pin": "GP0",
        "driver": "vendor"
    },
    "processor": "RP2040",
    "bootloader": "rp2040"
}
